APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Remote MCP OAuth (Stage 2 POC). Production values must use HTTPS.
MARKETING_MCP_OAUTH_ISSUER="${APP_URL}"
MARKETING_MCP_RESOURCE="${APP_URL}/mcp"
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
CHATGPT_ERP_APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erp_lmg_new
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gunakan smtp di server agar kode OTP benar-benar dikirim ke email pengguna.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

LOGIN_OTP_EXPIRES_MINUTES=5
LOGIN_OTP_RESEND_SECONDS=60
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_BYPASS_EMAILS=admin@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Meta OAuth (server-side only; never expose META_CLIENT_SECRET to the browser)
META_CLIENT_ID=
META_CLIENT_SECRET=
META_CONFIG_ID=
META_REDIRECT_URI=https://erp.lightermediagroup.com/oauth/meta/callback
META_GRAPH_VERSION=v23.0

# n8n webhook untuk mengirim Purchase ketika harga CRM Human diisi/berubah.
CRM_PURCHASE_WEBHOOK_URL=
CRM_PURCHASE_WEBHOOK_SECRET=
CRM_PURCHASE_WEBHOOK_TIMEOUT=10

# n8n webhook untuk memperbarui data pada tab CRM Human.
CRM_HUMAN_REFRESH_WEBHOOK_URL=https://bmglbl3.n8n.bocindonesia.com/webhook/get-human-chat
CRM_HUMAN_REFRESH_WEBHOOK_TIMEOUT=600

# Threads OAuth (use the Threads App ID and Threads App Secret)
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=https://erp.lightermediagroup.com/oauth/threads/callback
THREADS_GRAPH_VERSION=v1.0

# TikTok Login Kit & Display API (server-side only)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://erp.lightermediagroup.com/oauth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.list

# WAHA (server-side only). Buat key baru setelah key lama dicabut.
WAHA_API_KEY=

# Cloudflare Realtime TURN. These server-only credentials create temporary
# browser credentials automatically for every live monitoring session.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL=3600

# Firebase / Cloud Firestore (server-side)
# Download the JSON key from Firebase Console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_DEFAULT_COLLECTION=
FIREBASE_ACTIVITY_LOG_COLLECTION=logs
FIREBASE_HTTP_TIMEOUT=30
FIREBASE_CONNECT_TIMEOUT=5
FIREBASE_RETRY_TIMES=1
FIREBASE_TOKEN_CACHE_SECONDS=3300

# Digital Marketing MCP private PDF uploads (server-side only)
MARKETING_MCP_DOCUMENT_MAX_KB=20480
MARKETING_MCP_DOCUMENT_DISK=local

# Firebase Web SDK untuk sinyal real-time Live Monitoring.
# Nilai ini berasal dari Firebase Console > Project settings > Your apps > Web app.
# Nilai Web SDK memang dapat berada di browser; jangan pernah memasukkan isi
# service-account.json ke variabel ini.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID="${FIREBASE_PROJECT_ID}"
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
