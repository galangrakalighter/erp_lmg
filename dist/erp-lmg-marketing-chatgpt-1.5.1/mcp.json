{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "erp-lmg-marketing": {
      "type": "streamable-http",
      "url": "https://erp.lightermediagroup.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "01a13d64-fecf-7066-95d3-d7a98a991b52",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://erp.lightermediagroup.com/oauth/authorize",
            "tokenUrl": "https://erp.lightermediagroup.com/oauth/token",
            "baseScopes": ["marketing:read", "marketing:write", "offline_access"]
          }
        }
      }
    }
  }
}
